# PostgreSQL bağlantısı (sunucu tarafı, tarayıcıya asla gönderilmez)
DATABASE_URL=postgresql://aka_app:CHANGE_ME@localhost:5432/aka_egitim

# Admin oturum cookie'sini imzalamak için rastgele, uzun bir gizli anahtar.
# Üretmek için: openssl rand -hex 32
ADMIN_SESSION_SECRET=CHANGE_ME

# Sitenin canlı adresi (SEO / OpenGraph için)
NEXT_PUBLIC_SITE_URL=CHANGE_ME

# Yüklenen dosyaların diskte tutulacağı klasör (mutlak yol önerilir).
# Belirtilmezse proje kökünde ./uploads kullanılır.
UPLOAD_DIR=/var/www/aka-uploads
